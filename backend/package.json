{
  "name": "prjs5-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
   "dev": "node --import tsx --watch src/server.ts",
"build": "tsc",
"start": "node dist/src/server.js",
"check": "tsc --noEmit",
"db:setup-auth": "node --import tsx scripts/setup-auth.ts",
"db:setup-questions": "node --import tsx scripts/setup-questions.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
